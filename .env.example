LLM_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01
# Empty URL uses an ephemeral in-memory collection, re-ingested on startup.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=company_docs
SQLITE_PATH=data/company.db
# TOP_K=4

# Baseline preserves Phase 2. Optimized enables all OPT_* defaults.
PROFILE=baseline
# Individual overrides (uncomment to override profile defaults):
# OPT_ROUTER_MODEL=false
# OPT_CACHE=false
# OPT_PARALLEL=false
# OPT_TOP_K=false
# OPT_SHORT_PROMPTS=false
AZURE_OPENAI_ROUTER_DEPLOYMENT=
CACHE_TTL_SECONDS=900
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# TRACING_ENABLED=true
# Cost overrides in USD per million tokens (uncomment when setting a value):
# PRICE_CHAT_INPUT_PER_M=0.15
# PRICE_CHAT_OUTPUT_PER_M=0.60
# PRICE_EMBED_PER_M=0.02
# EVAL_MIN_ACCURACY=0.70
# BENCH_LATENCY_N=100
# BENCH_MAX_ACCURACY_DROP=0.02
